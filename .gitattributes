# Normalize line endings: keep Go (and other text) as LF in the repo so
# gofmt/CI stay happy regardless of the OS the file was authored on.
* text=auto eol=lf

# Explicitly force LF for source and config that the toolchain checks.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.example text eol=lf
.env.example text eol=lf
