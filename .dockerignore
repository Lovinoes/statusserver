# Only source/ is needed to build the image; keep everything else out of the
# build context.

# VCS / CI
.git
.gitignore
.github

# Docs, examples & deployment files
*.md
LICENSE
statusserver.service
nginx.conf.example
docker-compose*.yml
.env.example
config.example.json

# Local config & runtime state (configure the container via env instead)
**/config.json
**/uptime.json*
**/*.log
.env

# Build outputs and secrets
**/statusserver
**/statusserver.exe
**/*.exe
**/*.pem
**/*.key
/dist/
/out/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
