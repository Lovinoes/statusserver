# reverse proxy for the status server on 127.0.0.1:8090. drop this into a
# server{} block (with your own ssl_certificate lines).
#
# heads up: terminating tls here means nginx's tls settings apply to clients,
# not the agent's. the agent's tls 1.3-only / post-quantum (X25519MLKEM768)
# profile only kicks in when the agent serves tls itself (set tls_cert/tls_key
# and point clients straight at it). to keep that end-to-end, either terminate
# at the agent or give nginx an equivalent `ssl_protocols TLSv1.3;` + matching
# curves.

server {
    listen 443 ssl;
    server_name monitor.example.com;

    # ssl_certificate     /etc/letsencrypt/live/monitor.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/monitor.example.com/privkey.pem;

    location /ws {
        proxy_pass http://127.0.0.1:8090/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # needed if you enable TRUST_PROXY_HEADERS so per-ip limits see the
        # real client ip instead of 127.0.0.1.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;   # keep long-lived websockets alive
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8090/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
