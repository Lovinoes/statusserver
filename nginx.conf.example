# reverse proxy for the status server on 127.0.0.1:8090. drop this into your
# nginx config (with your own ssl_certificate lines).
#
# run the agent with LISTEN_ADDR=127.0.0.1:8090 so it's only reachable through
# nginx, and set TRUST_PROXY_HEADERS=true so per-ip websocket limits see the
# real client ip. the agent takes the LAST X-Forwarded-For entry - the one
# nginx appends below - so a client can't spoof its ip by sending its own
# X-Forwarded-For header. this assumes nginx is the only proxy in front.
#
# heads up: terminating tls here means nginx's tls settings apply to clients,
# not the agent's. the agent's tls 1.3-only / post-quantum (X25519MLKEM768)
# profile only kicks in when the agent serves tls itself (set tls_cert/tls_key
# and point clients straight at it). to keep that end-to-end, either terminate
# at the agent or give nginx an equivalent `ssl_protocols TLSv1.3;` + matching
# curves.

server {
    listen 443 ssl;
    server_name monitor.example.com;

    # ssl_certificate     /etc/letsencrypt/live/monitor.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/monitor.example.com/privkey.pem;

    location = /ws {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # the agent pings every 30s, so this only has to outlast one ping.
        proxy_read_timeout 120s;
    }

    location = /api/status {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # optional: expose prometheus metrics (still token-protected).
    # location = /metrics {
    #     proxy_pass http://127.0.0.1:8090;
    #     proxy_set_header Host $host;
    # }
}
