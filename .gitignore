# --- Compiled binaries ---
# `go build` in source/ produces source/statusserver(.exe); cross-compiled
# variants are statusserver-<os>-<arch>.
statusserver
statusserver.exe
statusserver-*
!statusserver.service
*.exe

# --- Local runtime config and persisted state ---
# Real config lives locally; only config.example.json is tracked.
config.json
*.local.json
# Persisted uptime history, its atomic-write temp file, and a moved-aside
# corrupt copy.
uptime.json
uptime.json.tmp
uptime.json.corrupt

# --- Secrets: TLS material and env files ---
# The server can serve native TLS, so never commit keys/certs.
*.pem
*.key
*.crt
*.cert
*.csr
*.p12
*.pfx
# Local Compose / runtime env (keep .env.example tracked).
.env
.env.*
!.env.example

# --- Go build/test artifacts ---
*.test
*.out
*.prof
coverage.*
/dist/
/bin/
*.o
*.a
*.so
__debug_bin*
/vendor/
/source/vendor/
go.work
go.work.sum
.gocache/

# --- Editor / OS noise ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
