# Copy to `.env` and adjust. docker-compose.yml reads these values.
# Anything not set here falls back to the defaults baked into the compose file.

# Host port to publish the agent on (container always listens on 8090).
PORT=8090

# Sample interval in seconds.
INTERVAL_SECONDS=5

# Shared secret required on /api/status, /ws and /metrics.
# Leave empty for open access (NOT recommended when internet-facing).
AUTH_TOKEN=

# Comma-separated CORS / websocket origin allow-list ("*" = any).
ALLOWED_ORIGINS=*

# Max concurrent websocket connections per client IP (0 = unlimited).
MAX_CONNS_PER_IP=10

# Trust X-Forwarded-For for the client IP. Enable ONLY behind a trusted
# reverse proxy; otherwise clients can spoof it and evade MAX_CONNS_PER_IP.
TRUST_PROXY_HEADERS=false

# Verbose debug logging. Every HTTP request is logged either way; enabling
# this adds request headers, per-tick collection detail, sensor readings,
# websocket lifecycle and alert evaluation. Secrets are redacted.
DEBUG=false
