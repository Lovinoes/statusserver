# copy to `.env` and adjust. docker-compose.yml and docker-compose.host.yml
# read these.
# anything not set here falls back to the compose file defaults.

# docker-compose.yml: host port to publish the agent on (the container always
# listens on 8090).
# docker-compose.host.yml: no port mapping; set LISTEN_ADDR instead, e.g.
# LISTEN_ADDR=:8090
PORT=8090

# sample interval in seconds.
INTERVAL_SECONDS=5

# shared secret required on /api/status, /ws and /metrics.
# leave empty for open access (NOT recommended when internet-facing).
AUTH_TOKEN=

# comma-separated cors / websocket origin allow-list ("*" = any).
ALLOWED_ORIGINS=*

# max concurrent websocket connections per client ip (0 = unlimited).
MAX_CONNS_PER_IP=10

# trust X-Forwarded-For for the client ip. enable ONLY behind a trusted
# reverse proxy; otherwise clients can spoof it and dodge MAX_CONNS_PER_IP.
TRUST_PROXY_HEADERS=false

# verbose debug logging. every request is logged either way; this just adds
# request headers, collection detail, sensor readings, ws lifecycle and
# alerts. secrets are redacted.
DEBUG=false
